import tkinter as tk
import random

def play(choice):
    options = ["Rock", "Paper", "Scissor"]
    computer = random.choice(options)
    if choice == computer:
        result = "Draw"
    elif (choice == "Rock" and computer == "Scissor") or \
         (choice == "Paper" and computer == "Rock") or \
         (choice == "Scissor" and computer == "Paper"):
        result = "You Win!"
    else:
        result = "You Lose!"
    label_result.config(text=f"Computer: {computer}\nResult: {result}")

root = tk.Tk()
root.title("Rock Paper Scissor")

tk.Label(root, text="Choose one:").pack()
for opt in ["Rock", "Paper", "Scissor"]:
    tk.Button(root, text=opt, command=lambda o=opt: play(o)).pack()

label_result = tk.Label(root, text="")
label_result.pack()

root.mainloop()
